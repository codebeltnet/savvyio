{
  "version": "1",
  "environments": [
    {
      "name": "WSL-Ubuntu",
      "type": "wsl",
      "wslDistribution": "Ubuntu-24.04"
    },
    {
      "name": "Docker-Ubuntu",
      "type": "docker",
      "dockerImage": "codebeltnet/ubuntu-testrunner:8-9-10-11",
      "dockerArgs": "-e AWS__CallerIdentity -e AWS__IAM__AccessKey -e AWS__IAM__SecretKey"
    }
  ]
}
